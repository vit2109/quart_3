# Application
APP_NAME=Data Analytics System
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production
UVICORN_RELOAD=false

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=analytics_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/analytics_db

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI / Local LLM (in-process, без внешних серверов)
# LLM_BACKEND: auto | llama_cpp | transformers
# transformers: локальный GGUF (если есть) или Hugging Face модель
# llama_cpp: нужен llama-cpp-python (на Windows — Visual Studio Build Tools)
LLAMA_MODEL_PATH=./models/qwen2.5-1.5b-instruct-q4_k_m.gguf
LLAMA_CONTEXT_SIZE=2048
LLAMA_MODELS_DIR=./models
LLAMA_HF_REPO=Qwen/Qwen2.5-1.5B-Instruct-GGUF
LLAMA_GGUF_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
LLM_BACKEND=transformers
TRANSFORMERS_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
# Отдельная модель для NL/SQL-запросов (необязательно; если не задана — основная)
# SQL_LLAMA_MODEL_PATH=./models/other-model.gguf
# SQL_TRANSFORMERS_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
LLM_TIMEOUT=300
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.4
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG
CHROMA_PERSIST_DIR=./chroma_db
RAG_TOP_K=5
# Лимиты индексации (снижают риск нехватки RAM / перезагрузки ПК)
KNOWLEDGE_MAX_TEXT_BYTES=2000000
KNOWLEDGE_MAX_CHUNKS=200
EMBEDDING_BATCH_SIZE=2
EMBEDDING_TORCH_THREADS=2
KNOWLEDGE_INDEX_PAUSE_MS=100
KNOWLEDGE_MIN_FREE_RAM_MB=800
KNOWLEDGE_USE_SUBPROCESS=true
KNOWLEDGE_FORCE_BACKGROUND=true
KNOWLEDGE_BACKGROUND_MIN_BYTES=1
KNOWLEDGE_SUBPROCESS_TIMEOUT=3600

# File Storage
UPLOAD_DIR=./uploads
REPORT_DIR=./reports
KNOWLEDGE_DIR=./knowledge
USER_DATA_DIR=./data
MAX_UPLOAD_SIZE=104857600

# Logging
LOG_LEVEL=INFO
